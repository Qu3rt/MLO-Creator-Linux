<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <AssemblyName>MloCreator</AssemblyName>
    <RootNamespace>MloCreator</RootNamespace>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <InvariantGlobalization>false</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <EnableDefaultCompileItems>true</EnableDefaultCompileItems>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <DebugType>portable</DebugType>
    <NoWarn>CS0168;CS0219;CS0414;CS0649;CS1998;CS0162</NoWarn>
    <AppendTargetFrameworkToOutputPath>true</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="StbImageSharp" Version="2.30.15" />
  </ItemGroup>

  <!-- The exact CodeWalker.Core/SharpDX build the modified Windows application uses. The NuGet 1.0.3
       build writes collision resources differently (material/vertex ordering), which changes how the
       game builds the bounds BVH; using the Windows build's own libraries keeps the exported files
       identical. They are netstandard2.0 and run on Linux. -->
  <ItemGroup>
    <Reference Include="CodeWalker.Core">
      <HintPath>$(MSBuildThisFileDirectory)../lib/CodeWalker.Core.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="SharpDX">
      <HintPath>$(MSBuildThisFileDirectory)../lib/SharpDX.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="SharpDX.Mathematics">
      <HintPath>$(MSBuildThisFileDirectory)../lib/SharpDX.Mathematics.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <!-- the editor (ported from the modified build) and its models are copied into the output -->
  <ItemGroup>
    <Content Include="$(MSBuildThisFileDirectory)../ui/**/*" Link="ui/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="$(MSBuildThisFileDirectory)../models/**/*" Link="models/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)../native/mlo-shell.c" />
    <None Include="$(MSBuildThisFileDirectory)../native/build-shell.sh" />
  </ItemGroup>

  <!-- the native window: GTK3 + WebKit2GTK, one small C program -->
  <Target Name="BuildNativeShell" AfterTargets="Build">
    <Exec Command="bash &quot;$(MSBuildThisFileDirectory)../native/build-shell.sh&quot; &quot;$(OutDir).&quot;" />
  </Target>
  <Target Name="BuildNativeShellPublish" AfterTargets="Publish">
    <Exec Command="bash &quot;$(MSBuildThisFileDirectory)../native/build-shell.sh&quot; &quot;$(PublishDir).&quot;" />
  </Target>

</Project>
